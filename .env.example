# ---------- AI provider ----------
# "gemini" (free tier, default when GEMINI_API_KEY is set) or "claude"
AI_PROVIDER=gemini

# Google Gemini API key — free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback chain (free-tier quotas are per model per day):
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Anthropic Claude API key (optional alternative) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# ---------- PayPal ----------
# Sandbox REST app credentials — https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run in MOCK mode (no real PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---------- Agent spending guardrails (USD) ----------
AUTO_REFUND_LIMIT=50
AUTO_PAYOUT_LIMIT=100
MAX_INVOICE=10000

# Public URL (used for PayPal return URLs on payment links). Auto-detected if blank.
# PUBLIC_URL=https://your-app.onrender.com
